<Project Sdk="Microsoft.NET.Sdk">

  <!-- RimWorld 1.7 (Waylith Beta): .NET 10 + Harmony 3 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RectShield</AssemblyName>
    <RootNamespace>RectShield</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <OutputPath>..\1.7\Assemblies\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <ManagedPath Condition="'$(ManagedPath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld\RimWorldWin64_Data\Managed</ManagedPath>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">$(ManagedPath)</HarmonyPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Mod\**\*.cs" />
    <Compile Include="UI\**\*.cs" />
    <Compile Include="Patches\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(ManagedPath)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(ManagedPath)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
