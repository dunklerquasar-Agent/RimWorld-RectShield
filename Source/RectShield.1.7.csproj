<Project Sdk="Microsoft.NET.Sdk">

  <!-- RimWorld 1.7 (Waylith Beta): .NET 10 + Harmony 3
       IMPORTANT: 1.7 has NO "RimWorldWin64_Data/Managed" folder.
       Assembly-CSharp.dll, UnityStubs.dll and Waylith.dll live in the
       GAME INSTALL ROOT. GameDir points there. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RectShield</AssemblyName>
    <RootNamespace>RectShield</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
    <OutputPath>..\1.7\Assemblies\</OutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Games\RimWorld_1_7_Beta</GameDir>
    <HarmonyPath Condition="'$(HarmonyPath)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\1.7\Assemblies</HarmonyPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Core\**\*.cs" />
    <Compile Include="Mod\**\*.cs" />
    <Compile Include="UI\**\*.cs" />
    <Compile Include="Patches\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityStubs">
      <HintPath>$(GameDir)\UnityStubs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(GameDir)\Waylith.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Waylith.UnityCompat" Condition="Exists('$(GameDir)\Waylith.UnityCompat.dll')">
      <HintPath>$(GameDir)\Waylith.UnityCompat.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyPath)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
