<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Eigener Forschungs-Tab: verhindert Kollisionen mit Vanilla-Koordinaten
       und zeigt beide Schild-Forschungen mit ihren Gebaeude-Icons.
       Wer alles im Haupt-Tab haben will: die <tab>-Zeilen in
       Research_RectShield.xml entfernen (dann researchViewX/Y anpassen). -->
  <ResearchTabDef>
    <defName>RectShield_ResearchTab</defName>
    <label>RectShield</label>
    <generalTitle>Rectangular shielding</generalTitle>
    <generalDescription>Shield generators that project a rectangular field instead of a circular dome.</generalDescription>
    <visibleByDefault>true</visibleByDefault>
  </ResearchTabDef>

</Defs>
